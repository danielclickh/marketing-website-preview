{
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn create-githubstars-file && yarn create-pricing-file && next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "build:analyze": "ANALYZE=true yarn build",
    "create-rss-xml": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register ./scripts/createRssXml",
    "create-static-sitemap": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register ./scripts/createStaticSitemap",
    "create-pricing-file": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register ./scripts/createPricingFile",
    "create-githubstars-file": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register ./scripts/getGitHubStars",
    "deploy": "yarn create-rss-xml && yarn create-githubstars-file && yarn create-static-sitemap && yarn create-pricing-file && next build",
    "lint": "next lint && yarn format:check",
    "format:check": "yarn prettier \"./src/**/*.{ts,tsx,css,scss,json,md,mdx}\" --check",
    "format": "yarn prettier \"./src/**/*.{ts,tsx,css,scss,json,md,mdx}\" --write",
    "export": "next export",
    "check:unused": "knip"
  },
