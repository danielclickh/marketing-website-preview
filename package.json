{
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": "24.x",
    "yarn": ">=4"
  },
  "scripts": {
    "pre-build": "yarn create-githubstars-file && yarn create-pricing-file",
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "build:analyze": "ANALYZE=true yarn build",
    "create-pricing-file": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register ./scripts/createPricingFile",
    "create-githubstars-file": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register ./scripts/getGitHubStars",
    "build-index": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register ./scripts/buildIndex",
    "sync-algolia": "ts-node --project tsconfig.scripts.json -r tsconfig-paths/register ./scripts/syncAlgolia",
    "deploy": "yarn pre-build && next build && yarn build-index && yarn sync-algolia",
    "lint": "next lint && yarn format:check",
    "format:check": "yarn prettier \"./src/**/*.{ts,tsx,css,scss,json,md,mdx}\" --check",
    "format": "yarn prettier \"./src/**/*.{ts,tsx,css,scss,json,md,mdx}\" --write",
    "export": "next export",
    "check:unused": "knip",
    "cms:toggle": "bash scripts/toggle-cms.sh",
    "dev:local-cms": "bash scripts/dev-local-cms.sh",
    "cms:local": "sed -i '' 's|STRAPI_API_URL=.*|STRAPI_API_URL=http://localhost:1337|' .env.local && echo 'CMS → local (http://localhost:1337). Restart dev server.'",
    "cms:remote": "sed -i '' 's|STRAPI_API_URL=.*|STRAPI_API_URL=https://cms.clickhouse-dev.com:1337|' .env.local && echo 'CMS → remote (https://cms.clickhouse-dev.com:1337). Restart dev server.'"
  },
  "dependencies": {
    "@clickhouse/click-ui": "^0.0.188",
    "@clickhouse/client-web": "^1.10.1",
    "@growthbook/growthbook-react": "^0.25.0",
    "@headlessui/react": "^1.7.10",
    "@heroicons/react": "^1.0.6",
    "@next/bundle-analyzer": "^15.3.0",
    "@next/third-parties": "^15.1.3",
    "@panzoom/panzoom": "^4.6.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-hook/resize-observer": "^2.0.2",
    "@slack/web-api": "^6.10.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@vercel/functions": "^3.1.3",
    "@vimeo/player": "^2.29.3",
    "algoliasearch": "^5.32.0",
    "classnames": "^2.3.2",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.3",
    "feed": "^4.2.2",
    "filesize": "^10.1.6",
    "framer-motion": "^10.16.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.376.0",
    "motion": "^12.12.1",
    "next": "14.2.35",
    "numeral": "^2.0.6",
    "p-limit": "^7.2.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "primereact": "^10.6.4",
    "qs": "6.14.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-glider": "^4.0.2",
    "react-instantsearch": "^7.16.1",
    "react-markdown": "^8.0.4",
    "react-parallax-tilt": "^1.7.120",
    "react-vertical-timeline-component": "^4.0.0",
    "rehype-highlight": "^6.0.0",
    "rehype-raw": "^6.1.1",
    "rehype-slug-custom-id": "^1.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^3.0.1",
    "remove-markdown": "^0.6.2",
    "sass": "^1.51.0",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.5",
    "short-uuid": "^5.2.0",
    "swiper": "^11.0.7",
    "swr": "^2.0.0",
    "three": "^0.176.0",
    "ts-node": "^10.9.1",
    "uuid": "^9.0.1",
    "youtube-player": "^5.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.9",
    "@types/jquery": "^3.5.16",
    "@types/lodash": "^4.14.202",
    "@types/node": "17.0.31",
    "@types/numeral": "^2.0.5",
    "@types/qs": "6.9.7",
    "@types/react": "18.0.8",
    "@types/react-dom": "18.0.3",
    "@types/three": "^0.176.0",
    "@types/uuid": "^9.0.8",
    "@types/vimeo__player": "^2.18.3",
    "@types/youtube-player": "^5.5.11",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@typescript-eslint/typescript-estree": "^8.21.0",
    "autoprefixer": "^10.4.19",
    "cheerio": "^1.1.1",
    "dotenv": "^16.5.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^14.2.25",
    "knip": "^5.60.0",
    "postcss": "^8.4.38",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "styled-components": "^6.1.11",
    "tailwindcss": "^3.4.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.7.3"
  }
}
